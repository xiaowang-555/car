{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Keil: 编译并烧录",
      "detail": "增量编译后经 ST-Link 烧录。编译不通过则中止，烧录失败自动重试一次。Ctrl+Shift+B 直接跑这个。",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-File", "${workspaceFolder}\\.vscode\\keil.ps1",
        "-Mode", "flash"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+)\\):\\s+(error|warning|fatal error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Keil: 编译",
      "detail": "只增量编译，不烧录。",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-File", "${workspaceFolder}\\.vscode\\keil.ps1",
        "-Mode", "build"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+)\\):\\s+(error|warning|fatal error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Keil: 完整重建",
      "detail": "重新编译所有源文件，用于排除增量编译的残留问题。",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-File", "${workspaceFolder}\\.vscode\\keil.ps1",
        "-Mode", "rebuild"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+)\\):\\s+(error|warning|fatal error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Keil: 仅烧录",
      "detail": "不编译，直接把现有的 Objects\\Project.axf 烧进芯片。",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-File", "${workspaceFolder}\\.vscode\\keil.ps1",
        "-Mode", "download"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    }
  ]
}
